{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "scripts/**/*.ts",
    "docs/**/*.ts",
    "deploy/**/*.ts"
  ],
  "exclude": ["packages/pwa", "packages/team-client", "**/node_modules"]
}
