# /etc/beamhop/failover.env on the STANDBY. See deploy/ha/failover.sh for every option.
# Check the primary by its own address, not the floating IP / DNS name that moves.
PRIMARY_URL=https://primary.relay.example.com/healthz
CHECK_INTERVAL=10
FAIL_THRESHOLD=3
MODE=systemd
# MODE=compose
# COMPOSE_FILE=/opt/beamhop/deploy/ha/compose.yaml
LITESTREAM_CONFIG=/etc/beamhop/litestream.yml
DB_PATH=/var/lib/beamhop/db/beamhop.sqlite
LOCAL_URL=https://127.0.0.1/healthz

# Litestream needs the bucket keys for the restore (same as /etc/beamhop/litestream.env):
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Move traffic here after promotion (pick one and fill its settings):
PROMOTE_HOOK=/usr/local/lib/beamhop/hooks/hetzner-floating-ip.sh
HCLOUD_TOKEN=
FLOATING_IP_ID=
SERVER_ID=
# PROMOTE_HOOK=/usr/local/lib/beamhop/hooks/digitalocean-reserved-ip.sh   (DO_TOKEN, RESERVED_IP)
# PROMOTE_HOOK=/usr/local/lib/beamhop/hooks/gcp-static-ip.sh              (STATIC_IP, PRIMARY_VM, STANDBY_VM, ZONE)
# PROMOTE_HOOK=/usr/local/lib/beamhop/hooks/cloudflare-dns.sh             (CF_API_TOKEN, CF_ZONE_ID, CF_RECORD_ID)
