# Patterns are anchored at the build context root: prefix with **/ to match at any depth. Everything not excluded
# here is copied into the runtime image, so local databases, blobs and env files must never get through.
**/node_modules
**/dist
**/.build
.git
.github
.vscode
.idea
# agent worktrees / local tool state: full checkouts that may hold their own data/ and .env files
.claude
# runtime data from a server started anywhere in the tree (e.g. `bun run dev` inside packages/server)
**/data
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.mmdb
**/.env
**/.env.*
**/beamhop.config.json
# credentials and key material that may sit in a working tree (registry tokens, TLS keys, nsec backups)
**/.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.nsec
# backups and dumps (contain every event plus admin credentials and the relay secret key)
**/*.bak
**/*.dump
**/*.pgc
**/*.sql.gz
**/backups
**/*.log
**/*.tgz
**/.tmp-*
**/coverage
# test suites and their artifacts (e2e/.tmp holds generated owner keys and session cookies) never ship; e2e keeps only
# its package.json, which `bun install --frozen-lockfile` needs because it is a workspace
**/test
**/.tmp
**/test-results
**/playwright-report
e2e/*
!e2e/package.json
docs
**/.DS_Store
*.tsbuildinfo
Dockerfile
docker-compose.yml
