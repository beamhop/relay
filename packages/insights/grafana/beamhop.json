{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Beamhop relay",
  "uid": "beamhop-relay",
  "tags": ["beamhop", "nostr"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "relay",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(beamhop_connections, relay)",
        "definition": "label_values(beamhop_connections, relay)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "label": "Relay",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health score",
      "description": "Weighted health score (0-100) from all subsystem checks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "beamhop_health_score{relay=~\"$relay\"}",
          "legendFormat": "{{relay}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (beamhop_connections{relay=~\"$relay\"})",
          "legendFormat": "{{relay}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events accepted / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_events_accepted_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "{{relay}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(beamhop_errors_total[$__rate_interval]))",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_events_accepted_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "accepted {{relay}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_events_rejected_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "rejected {{relay}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_events_held_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "held {{relay}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rejections by reason",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(beamhop_events_rejected_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Subscriptions (REQ) / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_req_served_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "{{relay}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (relay) (beamhop_event_latency_milliseconds{relay=~\"$relay\",quantile=\"0.5\"})",
          "legendFormat": "post p50 {{relay}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (relay) (beamhop_event_latency_milliseconds{relay=~\"$relay\",quantile=\"0.95\"})",
          "legendFormat": "post p95 {{relay}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (relay) (beamhop_req_latency_milliseconds{relay=~\"$relay\",quantile=\"0.95\"})",
          "legendFormat": "read p95 {{relay}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (beamhop_connections{relay=~\"$relay\"})",
          "legendFormat": "open {{relay}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_connections_opened_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "new/s {{relay}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Traffic in",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_events_bytes_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "{{relay}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Storage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "beamhop_storage_bytes{relay=~\"$relay\"}",
          "legendFormat": "database {{relay}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "beamhop_disk_free_bytes",
          "legendFormat": "disk free"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "beamhop_disk_total_bytes",
          "legendFormat": "disk total"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Media uploads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_blobs_uploaded_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "files/s {{relay}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (relay) (rate(beamhop_blobs_uploaded_bytes_total{relay=~\"$relay\"}[$__rate_interval]))",
          "legendFormat": "bytes/s {{relay}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Errors by source",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source) (rate(beamhop_errors_total[$__rate_interval]))",
          "legendFormat": "{{source}}"
        }
      ]
    }
  ]
}
