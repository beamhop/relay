exports[`generated help and completion (snapshots) bash, zsh and fish completion 1`] = `
"# beamhop bash completion (generated by \`beamhop completion bash\`)
_beamhop() {
  local cur prev key words_ i w n=0
  cur="\${COMP_WORDS[COMP_CWORD]}"
  prev="\${COMP_WORDS[COMP_CWORD-1]}"
  key=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    w="\${COMP_WORDS[i]}"
    case "$w" in
      -*) case " --url --token --data-dir --config --relay --audit-reason --domain --persona --storage --output --bunker --claim-code --invite-code --name --days --manifest --pubkey --role --relay-id --display-name --bytes --pubkeys --reason --in-json --scopes --expires-in-days " in *" $w "*) ((i++));; esac;;
      *) if ((n < 3)); then key="\${key:+$key }$w"; ((n++)); fi;;
    esac
  done
  words_=""
  case "$key|$prev" in
    'init|--persona') words_='public-social private-team wot-community media-host organization';;
    'init|--storage') words_='sqlite postgres memory';;
    'admins invite|--role') words_='owner admin moderator viewer';;
    'tokens create|--scopes') words_='relay.read config.write';;
  esac
  if [[ -n "$words_" ]]; then COMPREPLY=($(compgen -W "$words_" -- "$cur")); return; fi
  if [[ -z "$key" ]]; then
    words_='serve init login logout status config backup update rollback claim-code doctor move undo actions completion help admins media moderation tokens'
  else
    case "$key" in
    'serve') words_='';;
    'init') words_='--domain --persona --storage --force --output';;
    'login') words_='--bunker --claim-code --invite-code --name --days --nsec-stdin --print-token';;
    'logout') words_='';;
    'status') words_='';;
    'config') words_='export import diff history restore';;
    'config export') words_='';;
    'config import') words_='';;
    'config diff') words_='';;
    'config history') words_='';;
    'config restore') words_='';;
    'backup') words_='now list restore';;
    'backup now') words_='';;
    'backup list') words_='';;
    'backup restore') words_='';;
    'update') words_='--check --force --manifest';;
    'rollback') words_='';;
    'claim-code') words_='';;
    'doctor') words_='--fix';;
    'move') words_='export import verify';;
    'move export') words_='';;
    'move import') words_='';;
    'move verify') words_='';;
    'undo') words_='';;
    'actions') words_='';;
    'completion') words_='bash zsh fish';;
    'completion bash') words_='';;
    'completion zsh') words_='';;
    'completion fish') words_='';;
    'help') words_='';;
    'admins') words_='invite list';;
    'admins invite') words_='--pubkey --role --relay-id --display-name';;
    'admins list') words_='';;
    'media') words_='quota';;
    'media quota set') words_='--bytes';;
    'moderation') words_='ban-pubkey';;
    'moderation ban-pubkey') words_='--pubkeys --reason --remove-recent --in-json';;
    'tokens') words_='create';;
    'tokens create') words_='--name --scopes --expires-in-days';;
    esac
  fi
  if [[ "$cur" == -* ]]; then words_="$words_ --help --json --yes --preview --technical --url --token --data-dir --config --local --relay --audit-reason --no-color"; fi
  COMPREPLY=($(compgen -W "$words_" -- "$cur"))
}
complete -F _beamhop beamhop
"
`;

exports[`generated help and completion (snapshots) bash, zsh and fish completion 2`] = `
