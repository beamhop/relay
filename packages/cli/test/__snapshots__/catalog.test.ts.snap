// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generated help and completion (snapshots) action and group help 1`] = `
"Invite an admin

Does admins.invite

Usage: beamhop admins invite --pubkey <pubkey> --role <owner|admin|moderator|viewer> [options]

Options:
  --pubkey <pubkey>              Their npub or hex key (required)
  --role <owner|admin|moderator|viewer> What they may do (required)
  --relay-id <relay-id>          Only this relay
  --display-name <display-name>  

Shows what will change and asks before applying (--yes skips the question).
Can be undone for a few minutes with \`beamhop undo <token>\`.

Technical: action admins.invite, permission admins.manage, scope node
  kind 0 lookup
"
`;

exports[`generated help and completion (snapshots) action and group help 2`] = `
"Block account

Does moderation.ban-pubkey

Usage: beamhop moderation ban-pubkey --pubkeys <string>… [options]

Options:
  --pubkeys <string>…            (required) (repeatable or comma-separated)
  --reason <reason>              
  --remove-recent                Also remove their recent posts [default: false]
  --in-json <json>               Collides with --json

Works on one relay: pass --relay <id> if you have several.
Shows what will change and asks before applying (--yes skips the question).
Can be undone for a few minutes with \`beamhop undo <token>\`.
Bulk: --from-file <file> runs it for many items with one undo.
"
`;

exports[`generated help and completion (snapshots) action and group help 3`] = `
