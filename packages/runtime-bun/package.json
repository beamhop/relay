    "@beamhop/core": "workspace:*",
    "@beamhop/testkit": "workspace:*",
    "@beamhop/storage-sql": "workspace:*",
    "@beamhop/blobs": "workspace:*",
    "@beamhop/policy": "workspace:*",
    "@beamhop/relay": "workspace:*",
    "@beamhop/blossom": "workspace:*",
    "@beamhop/admin-api": "workspace:*",
    "@beamhop/insights": "workspace:*",
    "@beamhop/alerts": "workspace:*",
    "@beamhop/lifecycle": "workspace:*",
    "@beamhop/experience": "workspace:*",
    "@beamhop/public-web": "workspace:*",
    "@beamhop/media": "workspace:*",
    "@beamhop/ai": "workspace:*",
    "@beamhop/plugins": "workspace:*",
    "@beamhop/enterprise-identity": "workspace:*",
    "@beamhop/enterprise-keyvault": "workspace:*",
    "@beamhop/enterprise-compliance": "workspace:*",
    "@beamhop/otel": "workspace:*",
    "acme-client": "^5.4.0",
    "hono": "^4.13.13",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.1"
