{
  "name": "@beamhop/runtime-bun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Bun runtime: server, WebSocket, adapters wiring, TLS/ACME, single binary",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "beamhop-server": "./src/main.ts"
