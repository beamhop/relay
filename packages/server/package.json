{
  "name": "@beamhop/server",
  "version": "0.1.0",
  "description": "beamhop server: Nostr relay + Blossom media server + admin panel (composition root, CLI, runtime adapters, plugin manager)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "beamhop": "./dist/node/cli.js"
  },
  "files": [
    "dist/node"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts start",
    "start": "bun src/cli.ts start",
    "build:node": "bun scripts/build-node.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@beamhop/admin-api": "workspace:*",
    "@beamhop/blossom": "workspace:*",
    "@beamhop/core": "workspace:*",
    "@beamhop/metrics": "workspace:*",
    "@beamhop/sdk": "workspace:*",
    "@beamhop/storage": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "nostr-tools": "^2.25.2",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
