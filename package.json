{
  "name": "beamhop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "ci:spdx": "bun scripts/ci/spdx-check.ts",
    "ci:dco": "bun scripts/ci/dco-check.ts main..HEAD",
    "ci:vanilla": "cd packages/pwa && bun run build && cd ../.. && bun scripts/ci/vanilla-check.ts",
    "ci:cf-bundle": "bun scripts/ci/cf-bundle.ts",
    "smoke:linux": "bun scripts/smoke/linux.ts",
    "bench:load": "bun scripts/bench/load.ts",
    "bench:gate": "bun scripts/bench/gate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
